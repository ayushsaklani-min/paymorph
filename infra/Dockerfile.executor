FROM node:24-alpine AS build
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable
WORKDIR /workspace
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/executor/package.json apps/executor/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/shared/package.json packages/shared/package.json
RUN pnpm install --frozen-lockfile
COPY apps/executor apps/executor
COPY packages/db packages/db
COPY packages/shared packages/shared
RUN pnpm db:generate
RUN pnpm --filter @paymorph/executor... build
RUN pnpm deploy --filter @paymorph/executor --prod /deploy

FROM node:24-alpine AS runner
ENV NODE_ENV=production
WORKDIR /app
RUN addgroup --system --gid 1001 paymorph && adduser --system --uid 1001 paymorph
COPY --from=build --chown=paymorph:paymorph /deploy ./
USER paymorph
CMD ["node", "dist/index.js"]

