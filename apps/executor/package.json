{
  "name": "@paymorph/executor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --conditions=development --import tsx --watch src/index.ts",
    "build": "pnpm --filter @paymorph/shared build && pnpm --filter @paymorph/db build && tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "start:web": "node dist/web-service.js",
    "webhooks:deliver": "node dist/deliver-webhooks.js",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@flarenetwork/flare-wagmi-periphery-package": "^3.6.0",
    "@paymorph/db": "workspace:*",
    "@paymorph/shared": "workspace:*",
    "pino": "10.3.1",
    "viem": "2.55.8",
    "xrpl": "5.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
