{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://paymorph.example/schemas/deployment-manifest.json",
  "title": "PayMorph deployment manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "network",
    "chainId",
    "version",
    "commitSha",
    "deployer",
    "routerAddress",
    "adapterAddress",
    "assetManagerAddress",
    "fxrpAddress",
    "usdt0Address",
    "swapRouterAddress",
    "poolFee",
    "serviceFeeBps",
    "feeRecipient",
    "deployTransactionHashes"
  ],
  "properties": {
    "network": { "const": "coston2" },
    "chainId": { "const": 114 },
    "version": { "type": "string", "minLength": 1 },
    "commitSha": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "deployer": { "$ref": "#/$defs/address" },
    "routerAddress": { "$ref": "#/$defs/address" },
    "adapterAddress": { "$ref": "#/$defs/address" },
    "assetManagerAddress": { "$ref": "#/$defs/address" },
    "fxrpAddress": { "$ref": "#/$defs/address" },
    "usdt0Address": { "$ref": "#/$defs/address" },
    "swapRouterAddress": { "$ref": "#/$defs/address" },
    "poolFee": { "type": "integer", "minimum": 1, "maximum": 16777215 },
    "serviceFeeBps": { "type": "integer", "minimum": 0, "maximum": 300 },
    "feeRecipient": { "$ref": "#/$defs/address" },
    "deployTransactionHashes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/hash" }
    },
    "constructorArguments": { "type": "object" },
    "createdAt": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "address": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{40}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-fA-F]{64}$"
    }
  }
}
